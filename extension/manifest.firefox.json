{
  "manifest_version": 3,
  "name": "Focus Relay",
  "version": "4.1.0",
  "description": "Bloquea sitios distractores mientras la app Focus Relay tiene una sesión activa. La app es la central de control.",
  "permissions": [
    "storage",
    "alarms",
    "declarativeNetRequest",
    "activeTab"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "common.js",
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Focus Relay",
    "default_icon": {
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "style.css",
        "common.js",
        "i18n.js",
        "blocked.js",
        "icon48.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "focus-relay@focus-relay.app",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "homepage_url": "https://github.com/yopo3r/Focus-Relay"
}
